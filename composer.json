{
    "name": "albertotaboadaenvato/envato-theme-check",
    "description": "Envato Theme Check plugin for reviewing WordPress themes.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "squizlabs/php_codesniffer": "*",
        "phpcompatibility/php-compatibility": "^10@alpha",
        "phpcompatibility/phpcompatibility-wp": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "brain/monkey": "*",
        "mockery/mockery": "*",
        "wp-coding-standards/wpcs": "^3",
        "phpstan/phpstan": "^2",
        "szepeviktor/phpstan-wordpress": "*",
        "php-stubs/wordpress-stubs": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "*"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "TC\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/phpunit --testsuite unit",
        "test:integration": "vendor/bin/phpunit -c phpunit-integration.xml",
        "test:sweep": "vendor/bin/phpunit --testsuite sweep",
        "lint": "vendor/bin/phpcs",
        "analyse": "vendor/bin/phpstan analyse"
    }
}
